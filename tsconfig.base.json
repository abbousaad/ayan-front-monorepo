{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@acme/api-client": ["packages/api-client/src/index.ts"],
      "@acme/api-client/*": ["packages/api-client/src/*"],
      "@acme/cart": ["packages/cart/src/index.ts"],
      "@acme/cart/*": ["packages/cart/src/*"],
      "@acme/shared": ["packages/shared/src/index.ts"],
      "@acme/shared/*": ["packages/shared/src/*"]
    }
  }
}
